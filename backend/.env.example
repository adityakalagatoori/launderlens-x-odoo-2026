# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/traveloop?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_ACCESS_SECRET="your_access_secret_keep_it_long_and_secure"
JWT_REFRESH_SECRET="your_refresh_secret_keep_it_long_and_secure"

# Twilio Verify (SMS OTP)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_VERIFY_SERVICE_SID="VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# SMTP (Email Magic Links)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your_user"
SMTP_PASS="your_pass"

# OAuth
GOOGLE_CLIENT_ID="your_google_id"
GOOGLE_CLIENT_SECRET="your_google_secret"
APPLE_CLIENT_ID="your_apple_id"
FACEBOOK_CLIENT_ID="your_facebook_id"

# Frontend
FRONTEND_URL="http://localhost:3000"
