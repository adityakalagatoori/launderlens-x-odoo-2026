// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ── USER DOMAIN ──
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  name          String?
  avatar        String?
  bio           String?
  country       String?
  travelStyle   String?
  role          String    @default("USER")
  
  // Auth providers
  googleId      String?   @unique
  appleId       String?   @unique
  facebookId    String?   @unique
  passwordHash  String?
  
  // Magic link / OTP
  magicToken    String?   @unique
  magicExpires  DateTime?
  otpCode       String?
  otpExpires    DateTime?
  
  // Session management
  refreshToken  String?   @unique
  
  // Email verification
  isEmailVerified Boolean @default(false)
  verificationToken String? @unique

  // Profile & buddy matching preferences
  age             Int?
  gender          String?
  tripVibe        String?
  buddyPrefGender String?
  buddyPrefAgeMin Int?
  buddyPrefAgeMax Int?
  preferredBudget String?
  preferredRegions String?  // JSON array of preferred regions
  dietaryRestrictions String? // JSON array
  travelPace      String?    // e.g. "Slow", "Moderate", "Fast"
  activityTags    String?    // JSON array

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trips         Trip[]
  companions    TripCompanion[]
  wishlisted    Wishlist[]
  cityWishlists CityWishlist[]
  expenses      Expense[]
  notes         Note[]
  reviews       Review[]
  followers     Follow[]  @relation("following")
  following     Follow[]  @relation("follower")
  communityPosts CommunityPost[]
  communityComments CommunityComment[]
  guideBookings GuideTripBooking[]

  @@index([email, phone])
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  follower    User   @relation("follower", fields: [followerId], references: [id])
  followingId String
  following   User   @relation("following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
}

// ── TRIP DOMAIN ──
model Trip {
  id          String   @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  coverPhoto  String?
  tripType    String
  budget      Float    @default(0)
  currency    String   @default("USD")
  timezone    String   @default("UTC")
  visibility  String   @default("PRIVATE")
  tags        String   @default("[]")
  
  // Solo/Group & buddy matching
  tripMode        String  @default("solo")
  lookingForBuddy Boolean @default(false)
  
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  
  companions    TripCompanion[]
  itinerary     ItineraryStop[]
  expenses      Expense[]
  budgetCats    BudgetCategory[]
  packingLists  PackingList[]
  notes         Note[]
  carbonEmissions CarbonEmission[]
  albumPhotos   TripAlbumPhoto[]
  guideBookings GuideTripBooking[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TripCompanion {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("VIEWER")
  
  @@unique([tripId, userId])
}

// ── CITY DOMAIN ──
model City {
  id              String   @id @default(cuid())
  name            String
  country         String
  region          String
  description     String
  latitude        Float?
  longitude       Float?
  population      Int
  currency        String
  costLevel       Int
  rating          Float
  climate         String
  visaRequired    Boolean  @default(true)
  safetyScore     Int
  bestTimeToVisit String
  coverImage      String
  
  activities      Activity[]
  stops           ItineraryStop[]
  safetyAlerts    SafetyAlert[]
  cityWishlists   CityWishlist[]
  guides          TouristGuide[]
  
  // New discovery fields
  seasonalAlerts  String?   // JSON object with weather/traffic info
  hiddenGems      String?   // JSON array of points {name, lat, lng, description}
  bestTimeInfo    String?   // Detailed text
  highTrafficMonths String? // JSON array
  
  createdAt       DateTime @default(now())
}

// ── CITY WISHLIST ──
model CityWishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())
  
  @@unique([userId, cityId])
}

// ── ACTIVITY DOMAIN ──
model Activity {
  id            String   @id @default(cuid())
  cityId        String
  city          City     @relation(fields: [cityId], references: [id])
  name          String
  description   String
  category      String
  cost          Float
  duration      Int
  rating        Float
  reviewsCount  Int      @default(0)
  accessibility Boolean  @default(false)
  timeOfDay     String
  weatherIdeal  String
  imageUrl      String
  
  wishlists     Wishlist[]
  itineraryActs ItineraryActivity[]
}

model Wishlist {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])
  priceAlert Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  @@unique([userId, activityId])
}

// ── ITINERARY DOMAIN ──
model ItineraryStop {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId     String
  city       City     @relation(fields: [cityId], references: [id])
  order      Int
  daysCount  Int      @default(1)
  notes      String?
  
  activities ItineraryActivity[]
  
  createdAt  DateTime @default(now())
}

model ItineraryActivity {
  id         String   @id @default(cuid())
  stopId     String
  stop       ItineraryStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])
  day        Int      @default(1)
  timeStart  String?
  timeEnd    String?
  notes      String?
  
  createdAt  DateTime @default(now())
}

// ── BUDGET DOMAIN ──
model BudgetCategory {
  id        String @id @default(cuid())
  tripId    String
  trip      Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  label     String
  allocated Float  @default(0)
  spent     Float  @default(0)
}

model Expense {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  currency  String   @default("USD")
  category  String
  description String?
  date      DateTime @default(now())
  receiptUrl String?
  
  createdAt DateTime @default(now())
}

// ── PACKING DOMAIN ──
model PackingList {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name       String
  
  items      PackingItem[]
  createdAt  DateTime @default(now())
}

model PackingItem {
  id       String  @id @default(cuid())
  listId   String
  list     PackingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name     String
  category String
  isPacked Boolean @default(false)
  quantity Int     @default(1)
}

// ── JOURNAL DOMAIN ──
model Note {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  day       Int?
  title     String?
  body      String
  mood      String?
  energy    Int?
  imageUrl  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── TRIP ALBUM DOMAIN ──
model TripAlbumPhoto {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  mediaUrl   String
  mediaType  String   @default("photo")
  caption    String?
  timestamp  DateTime @default(now())
  isCover    Boolean  @default(false)
  
  createdAt  DateTime @default(now())
}

// ── SAFETY DOMAIN ──
model SafetyAlert {
  id        String   @id @default(cuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  type      String
  body      String
  severity  String
  validUntil DateTime?
  
  createdAt DateTime @default(now())
}

// ── CARBON DOMAIN ──
model CarbonEmission {
  id      String @id @default(cuid())
  tripId  String
  trip    Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  mode    String
  kgCo2   Float
  
  createdAt DateTime @default(now())
}

// ── TOURIST GUIDE DOMAIN ──
model TouristGuide {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  cityId       String
  city         City     @relation(fields: [cityId], references: [id])
  languages    String   @default("[]")
  ratePerDay   Float    @default(0)
  experience   Int      @default(0)
  bio          String?
  avatar       String?
  rating       Float    @default(5.0)
  specialties  String?
  isVerified   Boolean  @default(false)
  
  bookings     GuideTripBooking[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GuideTripBooking {
  id        String       @id @default(cuid())
  tripId    String
  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guideId   String
  guide     TouristGuide @relation(fields: [guideId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  status    String       @default("PENDING")
  message   String?
  
  createdAt DateTime     @default(now())
}

// ── COMMUNITY DOMAIN ──
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  targetId  String
  targetType String
  rating    Float
  body      String
  
  createdAt DateTime @default(now())
}

model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   @default("text")
  title     String
  body      String?
  mediaUrl  String?
  likes     Int      @default(0)
  
  comments  CommunityComment[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  body      String
  
  createdAt DateTime      @default(now())
}
